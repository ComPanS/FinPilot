# Database
DATABASE_URL=
DIRECT_URL=

# Auth
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=

# Admin panel (optional — if not set, admin is disabled)
# Path segment for admin URL, e.g. internal-stats-xyz → /internal-stats-xyz
# Both required: ADMIN_PATH (server) and NEXT_PUBLIC_ADMIN_PATH (Edge/middleware)
ADMIN_PATH=
NEXT_PUBLIC_ADMIN_PATH=
# Comma-separated emails allowed to access admin, e.g. admin@example.com,owner@company.ru
ADMIN_ALLOWED_EMAILS=

# OAuth
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Encryption
ENCRYPTION_KEY=

# Cron
CRON_SECRET=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# AI
NEUROAPI_BASE_URL=
NEUROAPI_API_KEY=
NEUROAPI_MODEL=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
