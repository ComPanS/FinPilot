// ffinplaner - Prisma Schema
// PostgreSQL (Neon/Supabase compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// For local dev: DIRECT_URL can equal DATABASE_URL

// ============ Auth.js (NextAuth) ============
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String? // bcrypt hash for Credentials provider
  consentAt     DateTime? // 152-ФЗ, GDPR consent
  weeklyReport  Boolean   @default(false)
  tourCompleted Boolean   @default(false)
  trialUsedAt   DateTime? // антифрод: 1 триал на email
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  profiles     CashFlowProfile[]
  subscription Subscription?
  aiRequests   AIRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PendingEmailChange {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  token     String   @unique
  expiresAt DateTime

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime

  @@index([token])
  @@index([email])
}

// ============ Core Business ============
model CashFlowProfile {
  id           String   @id @default(cuid())
  userId       String
  name         String
  currency     String   @default("RUB")
  zoneGreenMin Int      @default(50000) // баланс >= это = зелёная зона
  zoneRedMax   Int      @default(-50000) // баланс < это = красная зона
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  regularExpenses    RegularExpense[]
  regularIncomes     RegularIncome[]
  manualTransactions ManualTransaction[]
  monthlyData        ProfileMonthlyData[]
  expectedEntries    ExpectedEntry[]
  actualEntries      ActualEntry[]
  scenarios          WhatIfScenario[]
  forecasts          Forecast[]
  cashFlowHistory    CashFlowHistory[]
  forecastSnapshots  ForecastSnapshot[]

  @@index([userId])
}

model ExpectedEntry {
  id         String   @id @default(cuid())
  profileId  String
  entityType String // "EXPENSE" | "INCOME" | "MONTHLY_TOTAL"
  entityId   String? // null for MONTHLY_TOTAL
  period     String // "2025-03" or "2025-03-15"
  amount     Decimal  @db.Decimal(14, 2)
  confidence Float?   @default(1.0) // 0.0-1.0 for AI forecasts
  source     String   @default("MANUAL") // MANUAL | AUTO_HISTORICAL | AI | SALES_PLAN
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, entityType, entityId, period])
  @@index([profileId, period])
  @@index([entityId])
}

model ActualEntry {
  id         String   @id @default(cuid())
  profileId  String
  entityType String // "EXPENSE" | "INCOME"
  entityId   String // RegularExpense.id | RegularIncome.id
  period     String // YYYY-MM | YYYY-MM-DD | "YYYY-MM-DD:YYYY-MM-DD"
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  profile CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, entityType, entityId, period])
  @@index([profileId])
  @@index([entityId])
  @@index([profileId, period])
}

model ProfileMonthlyData {
  id        String   @id @default(cuid())
  profileId String
  month     String // YYYY-MM
  income    Decimal  @db.Decimal(14, 2) // доход за месяц
  expense   Decimal  @db.Decimal(14, 2) // расход за месяц
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, month])
  @@index([profileId])
}

model CashFlowHistory {
  id         String   @id @default(cuid())
  profileId  String
  entityType String // EXPENSE, INCOME, MANUAL
  entityId   String
  action     String // create, update, delete
  oldData    Json? // состояние до изменения
  newData    Json? // состояние после
  createdAt  DateTime @default(now())

  profile CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([entityId])
}

model ForecastSnapshot {
  id           String   @id @default(cuid())
  profileId    String
  snapshotDate DateTime
  forecastData Json // [{date, balance, inflows, outflows}]
  createdAt    DateTime @default(now())

  profile CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([snapshotDate])
}

model ExpenseCategory {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  userId   String? // null = predefined
  isSystem Boolean @default(true)

  expenses              RegularExpense[]
  manualTransactionsOut ManualTransaction[] @relation("ManualTransactionExpenseCategory")

  @@index([userId])
}

model IncomeCategory {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  userId   String? // null = predefined
  isSystem Boolean @default(true)

  regularIncomes       RegularIncome[]
  manualTransactionsIn ManualTransaction[] @relation("ManualTransactionIncomeCategory")

  @@index([userId])
}

model RegularExpense {
  id                 String   @id @default(cuid())
  profileId          String
  categoryId         String
  name               String
  amount             Decimal  @db.Decimal(14, 2)
  frequency          String // MONTHLY, QUARTERLY, YEARLY, WEEKLY, DAILY, CUSTOM
  customDays         Int? // used when frequency is CUSTOM
  startDate          DateTime
  expectedData       Json? // { "YYYY-MM": number } optional user-entered expected amounts per month (deprecated, use ExpectedEntry)
  seasonalMultiplier Json? // { "03": 1.2, "12": 0.8 } for seasonality by month
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  profile  CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([profileId])
}

model RegularIncome {
  id                 String    @id @default(cuid())
  profileId          String
  name               String
  amount             Decimal?  @db.Decimal(14, 2) // sum per occurrence (preferred over avgCheck)
  avgCheck           Decimal?  @db.Decimal(14, 2) // deprecated, use amount
  taxes              Decimal?  @db.Decimal(14, 2) // налоги (по умолчанию 0)
  salesPlan          Json? // { "1": number, ... } optional monthly plan
  frequency          String    @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY, WEEKLY, DAILY, CUSTOM
  customDays         Int? // used when frequency is CUSTOM
  categoryId         String? // FK to IncomeCategory (kept for backward compat, maps to income category)
  startDate          DateTime? // for frequency-based distribution
  expectedData       Json? // { "YYYY-MM": number } optional user-entered expected amounts per month (deprecated, use ExpectedEntry)
  seasonalMultiplier Json? // { "03": 1.2, "12": 0.8 } for seasonality by month
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile  CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category IncomeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([profileId])
}

model ManualTransaction {
  id                String   @id @default(cuid())
  profileId         String
  expenseCategoryId String? // для type=OUT
  incomeCategoryId  String? // для type=IN
  date              DateTime
  type              String // IN, OUT
  amount            Decimal  @db.Decimal(14, 2)
  taxes             Decimal? @db.Decimal(14, 2) // налоги (по умолчанию 0)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile         CashFlowProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory? @relation("ManualTransactionExpenseCategory", fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  incomeCategory  IncomeCategory?  @relation("ManualTransactionIncomeCategory", fields: [incomeCategoryId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([date])
  @@index([profileId, date])
}

model WhatIfScenario {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  changesJson Json
  createdAt   DateTime @default(now())

  profile CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Forecast {
  id               String   @id @default(cuid())
  profileId        String
  date             DateTime
  projectedBalance Decimal  @db.Decimal(14, 2)
  actualBalance    Decimal? @db.Decimal(14, 2)

  profile CashFlowProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId])
  @@index([date])
}

// ============ Billing ============
model Subscription {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  plan                    String // FREE, STANDARD, PRO, TRIAL
  billingPeriod           String? // monthly, yearly — для автосписаний
  status                  String // active, canceled, past_due
  cancelAtPeriodEnd       Boolean   @default(false)
  trialEndsAt             DateTime?
  yookassaPaymentId       String?
  yookassaPaymentMethodId String?
  currentPeriodEnd        DateTime?
  reportExportsCount      Int       @default(0)
  reportExportsMonth      String? // YYYY-MM, reset when month changes
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ AI ============
model AIRequest {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  response  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
