# Nginx reverse proxy for FinPilot on VPS
# Place in /etc/nginx/sites-available/finpilot (or sites-enabled)
# SSL: certbot --nginx -d ffinplaner.ru

server {
    listen 80;
    server_name ffinplaner.ru www.ffinplaner.ru;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ffinplaner.ru www.ffinplaner.ru;

    # SSL (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/ffinplaner.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ffinplaner.ru/privkey.pem;

    # Proxy to Docker app
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
