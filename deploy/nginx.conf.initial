# Начальный конфиг — только HTTP. Использовать ДО получения SSL.
# 1. Скопировать этот файл
# 2. Запустить certbot — он добавит SSL
# 3. После certbot можно заменить на nginx.conf.example (полный конфиг)
#
# ВАЖНО: В DNS должны быть A-запись для ffinplaner.ru и CNAME для www.ffinplaner.ru

# Редирект www -> основной домен
server {
    listen 80;
    server_name www.ffinplaner.ru;
    return 301 http://ffinplaner.ru$request_uri;
}

server {
    listen 80;
    server_name ffinplaner.ru;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
